<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.gj.mall</groupId>
        <artifactId>gj-mall-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>gj-mall-app</artifactId>
    <name>gj-mall-app</name>
    <description>启动模块：Main 入口，聚合所有业务模块</description>

    <dependencies>
        <dependency><groupId>com.gj.mall</groupId><artifactId>gj-mall-framework</artifactId></dependency>
        <dependency><groupId>com.gj.mall</groupId><artifactId>gj-mall-user</artifactId></dependency>
        <dependency><groupId>com.gj.mall</groupId><artifactId>gj-mall-product</artifactId></dependency>
        <dependency><groupId>com.gj.mall</groupId><artifactId>gj-mall-cart</artifactId></dependency>
        <dependency><groupId>com.gj.mall</groupId><artifactId>gj-mall-order</artifactId></dependency>
        <dependency><groupId>com.gj.mall</groupId><artifactId>gj-mall-pay</artifactId></dependency>
        <dependency><groupId>com.gj.mall</groupId><artifactId>gj-mall-marketing</artifactId></dependency>
        <dependency><groupId>com.gj.mall</groupId><artifactId>gj-mall-search</artifactId></dependency>
        <dependency><groupId>com.gj.mall</groupId><artifactId>gj-mall-admin-api</artifactId></dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>gj-mall-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.gj.mall.MallApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
